{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://studio51.solutions/schema/studio51.config.schema.json",
  "title": "Studio51 standards config",
  "description": "Org-wide defaults consumed by @studio51/create.",
  "type": "object",
  "additionalProperties": false,
  "required": ["org", "defaults", "licenses", "stacks", "types"],
  "properties": {
    "$schema": { "type": "string" },
    "org": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handle", "url", "legalName", "author", "email"],
      "properties": {
        "handle": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "legalName": { "type": "string" },
        "author": { "type": "string" },
        "ownerHandle": {
          "type": "string",
          "description": "GitHub username (or existing team, as org/team) used as the default CODEOWNERS owner."
        },
        "email": { "type": "string", "format": "email" },
        "website": { "type": "string", "format": "uri" },
        "securityContact": { "type": "string" }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["license", "visibility", "stack"],
      "properties": {
        "license": { "type": "string" },
        "visibility": { "enum": ["public", "private"] },
        "stack": { "type": "string" }
      }
    },
    "standards": {
      "type": "object",
      "description": "Current version per standard slug (e.g. api-gem → v1); see standards/<slug>/<version>/STANDARD.md.",
      "additionalProperties": { "type": "string", "pattern": "^v[0-9]+$" }
    },
    "licenses": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "stacks": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "types": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
  }
}
